{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["analyst", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Workspace project grouping files, analyses, findings, and reports.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "targetType": { "type": "string", "enum": ["website", "apk", "exe", "source", "api", "mixed"] },
        "targetUrl": { "type": "string", "maxLength": 512 },
        "authorizationAttested": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "analysisCount": { "type": "integer" },
        "findingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "targetType", "authorizationAttested", "status", "analysisCount", "findingCount", "createdAt", "updatedAt"]
    },
    "UploadedFile": {
      "title": "UploadedFile",
      "description": "Metadata for safely inspected files uploaded to a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "fileCategory": { "type": "string", "enum": ["apk", "exe", "source", "openapi", "archive"] },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sizeBytes": { "type": "integer" },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        "previewText": { "type": "string", "maxLength": 16000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "fileName", "fileCategory", "mimeType", "sizeBytes", "sha256", "createdAt"]
    },
    "AnalysisJob": {
      "title": "AnalysisJob",
      "description": "Execution or scheduled automation job for static software analysis.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "analyzerType": { "type": "string", "enum": ["website", "apk", "exe", "source", "api", "security"] },
        "targetLabel": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "type": "string", "enum": ["queued", "running", "completed", "failed"] },
        "scheduleInterval": { "type": "string", "enum": ["once", "hourly", "daily", "weekly"] },
        "automationEnabled": { "type": "boolean" },
        "lastRunHash": { "type": "string", "maxLength": 128 },
        "errorMessage": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "analyzerType", "targetLabel", "status", "scheduleInterval", "automationEnabled", "createdAt", "updatedAt"]
    },
    "AnalysisResult": {
      "title": "AnalysisResult",
      "description": "Structured static inspection result generated by an OpenReverse AI analyzer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "analyzerType": { "type": "string", "enum": ["website", "apk", "exe", "source", "api", "security"] },
        "targetLabel": { "type": "string", "minLength": 1, "maxLength": 512 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "riskScore": { "type": "number" },
        "findingCount": { "type": "integer" },
        "data": { "type": "object" },
        "limitations": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "jobId", "analyzerType", "targetLabel", "summary", "riskScore", "findingCount", "data", "createdAt"]
    },
    "SecurityFinding": {
      "title": "SecurityFinding",
      "description": "Defensive security observation with evidence and remediation guidance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "resultId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 120 },
        "owaspRef": { "type": "string", "maxLength": 80 },
        "evidence": { "type": "string", "maxLength": 2000 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "acknowledged", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "resultId", "title", "severity", "category", "remediation", "status", "createdAt", "updatedAt"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "AI Code Intelligence conversation thread with Gemini or local Ollama.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": { "type": "string", "enum": ["en", "bn"] },
        "provider": { "type": "string", "enum": ["gemini", "ollama"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "language", "provider", "model", "messages", "createdAt", "updatedAt"]
    },
    "ReportRecord": {
      "title": "ReportRecord",
      "description": "Generated report record supporting PDF, HTML, JSON, and Markdown export.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "format": { "type": "string", "enum": ["pdf", "html", "json", "markdown"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "findingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "projectId", "title", "format", "summary", "findingCount", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "User workspace notification for analysis completions, changes, or alerts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 600 },
        "category": { "type": "string", "enum": ["analysis", "security", "automation", "system"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "message", "category", "read", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only user activity audit log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resourceType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "details": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "action", "resourceType", "resourceId", "createdAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User-level theme, AI provider, Ollama connector, and localization preferences.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "aiProvider": { "type": "string", "enum": ["gemini", "ollama"] },
        "geminiModel": { "type": "string", "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"] },
        "ollamaBaseUrl": { "type": "string", "maxLength": 256 },
        "ollamaModel": { "type": "string", "maxLength": 100 },
        "preferredLanguage": { "type": "string", "enum": ["en", "bn"] },
        "emailNotifications": { "type": "boolean" },
        "totalAiRequests": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "theme", "aiProvider", "geminiModel", "preferredLanguage", "emailNotifications", "totalAiRequests", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents restricted to the owner."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Authorized reverse engineering and security projects owned by a user."
    },
    "/uploadedFiles/{fileId}": {
      "schema": { "$ref": "#/entities/UploadedFile" },
      "description": "Metadata and SHA-256 fingerprints of uploaded artifacts."
    },
    "/analysisJobs/{jobId}": {
      "schema": { "$ref": "#/entities/AnalysisJob" },
      "description": "Static analysis jobs and scheduled re-analysis automation tasks."
    },
    "/analysisResults/{resultId}": {
      "schema": { "$ref": "#/entities/AnalysisResult" },
      "description": "Structured static analysis outputs linked to jobs and projects."
    },
    "/securityFindings/{findingId}": {
      "schema": { "$ref": "#/entities/SecurityFinding" },
      "description": "Defensive security findings and remediation items."
    },
    "/aiConversations/{conversationId}": {
      "schema": { "$ref": "#/entities/AiConversation" },
      "description": "AI Code Intelligence chat sessions in English or Bengali."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ReportRecord" },
      "description": "Generated report export records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User notifications for completed jobs and change alerts."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit trail for user actions."
    },
    "/userSettings/{userId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User theme, AI provider, and localization settings."
    }
  }
}
